generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexión que usa la aplicación (en Supabase: Transaction pooler, puerto 6543)
  url       = env("DATABASE_URL")
  // Conexión directa para las migraciones (en Supabase: Session pooler, puerto 5432)
  directUrl = env("DIRECT_URL")
}

enum RolUsuario {
  DOCENTE
  ADMIN
}

model Usuario {
  id            String     @id @default(uuid())
  nombre        String
  email         String     @unique
  passwordHash  String
  rol           RolUsuario @default(DOCENTE)
  createdAt     DateTime   @default(now())
  planes        Plan[]
}

model Asignatura {
  id         String       @id @default(uuid())
  nombre     String
  nivel      String // ej: "5° básico"
  objetivos  Objetivo[]
  recursos   Recurso[]
  actividades Actividad[]
}

model Objetivo {
  id           String     @id @default(uuid())
  codigo       String // ej: "OA05"
  descripcion  String
  eje          String? // ej: "Números y Operaciones", "Lectura"
  asignatura   Asignatura @relation(fields: [asignaturaId], references: [id])
  asignaturaId String
  planes       Plan[]

  @@unique([asignaturaId, codigo])
}

enum TipoRecurso {
  VIDEO
  DOCUMENTO
  IMAGEN
}

model Recurso {
  id           String        @id @default(uuid())
  titulo       String
  tipo         TipoRecurso
  url          String?
  unidad       String
  asignatura   Asignatura    @relation(fields: [asignaturaId], references: [id])
  asignaturaId String
  createdAt    DateTime      @default(now())
  planes       PlanRecurso[]
}

model Actividad {
  id              String          @id @default(uuid())
  titulo          String
  descripcion     String
  duracionMinutos Int
  asignatura      Asignatura      @relation(fields: [asignaturaId], references: [id])
  asignaturaId    String
  createdAt       DateTime        @default(now())
  planes          PlanActividad[]
}

model Plan {
  id          String          @id @default(uuid())
  titulo      String
  fecha       DateTime
  notas       String?
  docente     Usuario         @relation(fields: [docenteId], references: [id])
  docenteId   String
  objetivo    Objetivo        @relation(fields: [objetivoId], references: [id])
  objetivoId  String
  createdAt   DateTime        @default(now())
  recursos    PlanRecurso[]
  actividades PlanActividad[]
}

// Recursos que se usan en una clase, en el orden en que se presentan.
model PlanRecurso {
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId    String
  recurso   Recurso @relation(fields: [recursoId], references: [id], onDelete: Cascade)
  recursoId String
  orden     Int     @default(0)

  @@id([planId, recursoId])
}

// Actividades que se realizan en una clase, en el orden en que se presentan.
model PlanActividad {
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId      String
  actividad   Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  actividadId String
  orden       Int       @default(0)

  @@id([planId, actividadId])
}
