# ── Base de datos ─────────────────────────────────────────────
# Opción A: Supabase (nube). Copia ambas URL desde Supabase → botón "Connect" → ORMs → Prisma.
#   DATABASE_URL usa el Transaction pooler (puerto 6543) y DIRECT_URL el Session pooler (puerto 5432).
# DATABASE_URL="postgresql://postgres.[ref]:[CONTRASEÑA]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[ref]:[CONTRASEÑA]@aws-0-[region].pooler.supabase.com:5432/postgres"
#
# Opción B: PostgreSQL local con Docker (docker compose up -d db). Ambas URL son iguales.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/software_educativo?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/software_educativo?schema=public"

# ── Seguridad ─────────────────────────────────────────────────
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# ── Servidor ──────────────────────────────────────────────────
# Render define PORT automáticamente; en local se usa 3000.
PORT=3000
